rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== Helper Functions =====
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isValidString(field) {
      return field is string && field.size() > 0;
    }
    
    function isValidNumber(field) {
      return field is number && field >= 0;
    }

    function historyMarker(userId) {
      return /databases/$(database)/documents/users/$(userId)/history/archive;
    }

    function acceptsArchive(userId, data) {
      return !exists(historyMarker(userId)) ||
        (data.get('archivedAt', null) is timestamp &&
         data.archivedAt > get(historyMarker(userId)).data.clearedThrough);
    }

    function isArchivedCrop(data) {
      return data.get('isArchived', false) || data.get('archivedAt', null) != null;
    }

    function resetMarker(userId) {
      return /databases/$(database)/documents/users/$(userId)/operations/farm_reset;
    }

    function farmResetBatch(userId, before) {
      let after = getAfter(resetMarker(userId));
      return before != null && after != null && before.data.status == 'running' &&
        after.data.status == 'running' && after.data.generation == before.data.generation &&
        after.data.get('batchToken', '') != before.data.get('batchToken', '');
    }

    function farmResetDeletes(userId) {
      return farmResetBatch(userId, get(resetMarker(userId)));
    }

    function farmCanDelete(userId) {
      let state = get(resetMarker(userId));
      return state == null || state.data.status == 'complete' || farmResetBatch(userId, state);
    }

    function farmCanWrite(userId, data) {
      return !exists(resetMarker(userId)) ||
        (get(resetMarker(userId)).data.status == 'complete' &&
         data.get('farmGeneration', null) == get(resetMarker(userId)).data.generation);
    }

    function isResetId(value) {
      return value is string && value.matches('^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$');
    }

    function isRunningReset(data) {
      return data.keys().hasOnly(['generation', 'baseGeneration', 'status', 'batchToken']) &&
        data.status == 'running' && isResetId(data.generation) && isResetId(data.batchToken) &&
        (data.baseGeneration == null || isResetId(data.baseGeneration));
    }
    
    // ===== User Profile =====
    match /users/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);

      match /operations/farm_reset {
        allow get: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId) &&
          isRunningReset(request.resource.data) && request.resource.data.baseGeneration == null;
        allow update: if isAuthenticated() && isOwner(userId) && (
          (resource.data.status == 'complete' && isRunningReset(request.resource.data) &&
           request.resource.data.baseGeneration == resource.data.generation &&
           request.resource.data.generation != resource.data.generation) ||
          (resource.data.status == 'running' && resource.data.get('leaseUntil', request.time) <= request.time &&
           request.resource.data.generation == resource.data.generation && (
             (isRunningReset(request.resource.data) &&
              request.resource.data.baseGeneration == resource.data.baseGeneration &&
              request.resource.data.batchToken != resource.data.get('batchToken', '')) ||
             (request.resource.data.status == 'complete' &&
              request.resource.data.keys().hasOnly(['generation', 'status']))
           ))
        );
      }

      // A reset queries these collection groups under this user's document.
      // This exposes orphaned expenses whose crop document was deleted earlier.
      match /{parent=**}/expenses/{expenseId} {
        allow list: if isAuthenticated() && isOwner(userId) &&
          get(resetMarker(userId)).data.status == 'running';
      }

      match /{parent=**}/expenses_history/{expenseId} {
        allow list: if isAuthenticated() && isOwner(userId) &&
          get(resetMarker(userId)).data.status == 'running';
      }
      
      // ===== Crops =====
      match /crops/{cropId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId)
          && isValidString(request.resource.data.name)
          && isValidString(request.resource.data.type)
          && farmCanWrite(userId, request.resource.data)
          && (!isArchivedCrop(request.resource.data) || acceptsArchive(userId, request.resource.data));
        allow update: if isAuthenticated() && isOwner(userId)
          && farmCanWrite(userId, request.resource.data)
          && (!isArchivedCrop(request.resource.data) || acceptsArchive(userId, request.resource.data));
        allow delete: if isAuthenticated() && isOwner(userId) && farmCanDelete(userId);
        
        // ===== Crop Expenses =====
        match /expenses/{expenseId} {
          function ownerCropAcceptsExpense() {
            let crop = get(/databases/$(database)/documents/users/$(userId)/crops/$(cropId));
            return crop.data != null &&
              (!isArchivedCrop(crop.data) || acceptsArchive(userId, crop.data));
          }
          allow read: if isAuthenticated() && isOwner(userId);
          allow create: if isAuthenticated() && isOwner(userId)
            && isValidString(request.resource.data.title)
            && isValidNumber(request.resource.data.amount) && ownerCropAcceptsExpense()
            && farmCanWrite(userId, request.resource.data);
          allow update: if isAuthenticated() && isOwner(userId) && ownerCropAcceptsExpense()
            && farmCanWrite(userId, request.resource.data);
          allow delete: if isAuthenticated() && isOwner(userId) && farmCanDelete(userId);
        }
      }
      
      // ===== Common Expenses =====
      match /common_expenses/{expenseId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId)
          && isValidString(request.resource.data.title)
            && isValidNumber(request.resource.data.amount) && farmCanWrite(userId, request.resource.data);
        allow update: if isAuthenticated() && isOwner(userId) && farmCanWrite(userId, request.resource.data);
        allow delete: if isAuthenticated() && isOwner(userId) && farmCanDelete(userId);
      }
      
      // ===== Crop History (archived crops) =====
      match /crop_history/{historyId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create, update: if isAuthenticated() && isOwner(userId)
          && acceptsArchive(userId, request.resource.data) && farmCanWrite(userId, request.resource.data);
        allow delete: if isAuthenticated() && isOwner(userId) && farmCanDelete(userId);
      }

      match /history/archive {
        allow get: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId) && farmResetDeletes(userId);
        allow create, update: if isAuthenticated() && isOwner(userId)
          && request.resource.data.keys().hasOnly(['clearedThrough', 'farmGeneration'])
          && farmCanWrite(userId, request.resource.data)
          && request.resource.data.clearedThrough is timestamp
          && request.resource.data.clearedThrough <= request.time
          && (resource == null || request.resource.data.clearedThrough > resource.data.clearedThrough);

        match /crops_history/{cropId} {
          allow read: if isAuthenticated() && isOwner(userId);
          allow delete: if isAuthenticated() && isOwner(userId) && farmCanDelete(userId);
          allow create, update: if isAuthenticated() && isOwner(userId)
            && acceptsArchive(userId, request.resource.data) && farmCanWrite(userId, request.resource.data);

          match /expenses_history/{expenseId} {
            function parentAcceptsArchiveExpense() {
              let crop = get(/databases/$(database)/documents/users/$(userId)/history/archive/crops_history/$(cropId));
              return !exists(historyMarker(userId)) ||
                (crop.data != null && acceptsArchive(userId, crop.data));
            }
            allow read: if isAuthenticated() && isOwner(userId);
            allow delete: if isAuthenticated() && isOwner(userId) && farmCanDelete(userId);
            allow create, update: if isAuthenticated() && isOwner(userId)
              && acceptsArchive(userId, request.resource.data) && parentAcceptsArchiveExpense()
              && farmCanWrite(userId, request.resource.data);
          }
        }

        match /common_expenses_history/{expenseId} {
          allow read: if isAuthenticated() && isOwner(userId);
          allow delete: if isAuthenticated() && isOwner(userId) && farmCanDelete(userId);
          allow create, update: if isAuthenticated() && isOwner(userId)
            && acceptsArchive(userId, request.resource.data) && farmCanWrite(userId, request.resource.data);
        }
      }
      
      // ===== Sales =====
      match /sales/{saleId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId)
          && isValidString(request.resource.data.cropId)
            && isValidNumber(request.resource.data.amount) && farmCanWrite(userId, request.resource.data);
        allow update: if isAuthenticated() && isOwner(userId) && farmCanWrite(userId, request.resource.data);
        allow delete: if isAuthenticated() && isOwner(userId) && farmCanDelete(userId);
      }
    }
    
    // ===== Market =====
    function marketStockChange(before, after, previous, next) {
      let quantity = previous.quantity;
      let reserved = before.get('reservedQuantity', 0);
      let available = before.availableQuantity;
      return quantity is int && quantity > 0 && before.unit == previous.unit &&
        before.produceName == previous.produceName &&
        after.diff(before).affectedKeys().hasOnly(['availableQuantity', 'reservedQuantity']) &&
        after.availableQuantity is int && after.reservedQuantity is int &&
        after.availableQuantity >= 0 && after.reservedQuantity >= 0 &&
        ((previous.status == 'requested' && next.status == 'accepted' &&
          before.status == 'active' &&
          after.availableQuantity == available - quantity && after.reservedQuantity == reserved + quantity) ||
         (previous.status == 'accepted' && next.status == 'cancelled' &&
          after.availableQuantity == available + quantity && after.reservedQuantity == reserved - quantity) ||
         (previous.status == 'accepted' && next.status == 'completed' &&
          after.availableQuantity == available && after.reservedQuantity == reserved - quantity));
    }

    match /market_places/{placeId} {
      allow read: if isAuthenticated();
    }

    match /market_profiles/{sellerUid} {
      function validPublishedProfile(data) {
        let fields = ['displayName', 'farmName', 'introduction', 'placeId',
                      'districtId', 'status', 'updatedAt'];
        return data.keys().hasOnly(fields) &&
          isValidString(data.displayName) && data.displayName.size() <= 80 &&
          data.get('farmName', '') is string && data.get('farmName', '').size() <= 80 &&
          data.introduction is string && data.introduction.size() <= 400 &&
          isValidString(data.placeId) && data.placeId.size() <= 120 &&
          data.placeId.matches('^[^/]+$') && isValidString(data.districtId) &&
          data.status == 'published' && data.updatedAt == request.time &&
          validMarketPlace(data.placeId, data.districtId);
      }

      function validMarketPlace(placeId, districtId) {
        let place = get(/databases/$(database)/documents/market_places/$(placeId));
        return place.data.districtId == districtId &&
          isValidString(place.data.name) && place.data.location is latlng;
      }

      function closedProfile(data) {
        return data.keys().hasOnly(['status', 'updatedAt']) &&
          data.status == 'closed' && data.updatedAt == request.time;
      }

      allow get: if isAuthenticated() &&
        (isOwner(sellerUid) || resource.data.status == 'published');
      allow list: if isAuthenticated() && resource.data.status == 'published';
      allow create: if isAuthenticated() && isOwner(sellerUid) &&
        (validPublishedProfile(request.resource.data) || closedProfile(request.resource.data));
      allow update: if isAuthenticated() && isOwner(sellerUid) &&
        resource.data.status != 'closed' &&
        (closedProfile(request.resource.data) || validPublishedProfile(request.resource.data) ||
         (resource.data.status == 'published' &&
          request.resource.data.status == 'hidden' &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])));

      match /listings/{listingId} {
        function shopIsPublished() {
          return get(/databases/$(database)/documents/market_profiles/$(sellerUid)).data.status == 'published';
        }

        function validListing(data) {
          return data.keys().hasOnly(['produceName', 'unit', 'pricePerUnitCents',
              'availableQuantity', 'minimumQuantity', 'pickupWindow', 'status',
              'reservedQuantity']) &&
            isValidString(data.produceName) && data.produceName.size() <= 80 &&
            data.unit in ['kg', 'bunch', 'piece'] &&
            data.pricePerUnitCents is int && data.pricePerUnitCents > 0 &&
            data.pricePerUnitCents <= 1000000000 &&
            data.availableQuantity is int && data.availableQuantity >= 0 &&
            data.availableQuantity + data.get('reservedQuantity', 0) <= 1000000000 &&
            data.minimumQuantity is int && data.minimumQuantity > 0 &&
            data.minimumQuantity <= 1000000000 &&
            isValidString(data.pickupWindow) && data.pickupWindow.size() <= 120 &&
            (data.status == 'paused' || (data.status == 'active' && shopIsPublished()));
        }

        function linkedStockUpdate(id, before, after) {
          let path = /databases/$(database)/documents/market_orders/$(id);
          let previous = get(path).data;
          let next = getAfter(path).data;
          return previous.sellerUid == sellerUid && previous.listingId == listingId &&
            (isOwner(previous.sellerUid) || isOwner(previous.buyerUid)) &&
            marketStockChange(before, after, previous, next);
        }

        allow read: if isAuthenticated() && (isOwner(sellerUid) ||
          (resource.data.status == 'active' && shopIsPublished()));
        allow create: if isAuthenticated() && isOwner(sellerUid) &&
          request.resource.data.status == 'active' && validListing(request.resource.data) &&
          request.resource.data.availableQuantity >= request.resource.data.minimumQuantity &&
          !request.resource.data.keys().hasAny(['reservedQuantity']);
        allow update: if isAuthenticated() && (
          (isOwner(sellerUid) && (
            (validListing(request.resource.data) &&
             !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reservedQuantity']) &&
             (resource.data.get('reservedQuantity', 0) == 0 ||
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['produceName', 'unit'])) &&
             (request.resource.data.minimumQuantity <= request.resource.data.availableQuantity ||
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['minimumQuantity', 'availableQuantity']))) ||
            (request.resource.data.status == 'paused' &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])))) ||
          linkedStockUpdate(
            getAfter(/databases/$(database)/documents/market_profiles/$(sellerUid)/listings/$(listingId)/operations/stock).data.orderId,
            resource.data, request.resource.data));

        match /operations/stock {
          allow create, update: if isAuthenticated() &&
            request.resource.data.keys().hasOnly(['orderId']) &&
            request.resource.data.orderId is string &&
            linkedStockUpdate(request.resource.data.orderId,
              get(/databases/$(database)/documents/market_profiles/$(sellerUid)/listings/$(listingId)).data,
              getAfter(/databases/$(database)/documents/market_profiles/$(sellerUid)/listings/$(listingId)).data);
        }
      }
    }

    match /market_orders/{orderId} {
      function safeDocumentId(value) {
        return isValidString(value) && value.size() <= 128 && value.matches('^[^/]+$');
      }

      function validOrderQuote(data) {
        let shop = /databases/$(database)/documents/market_profiles/$(data.sellerUid);
        let offer = get(/databases/$(database)/documents/market_profiles/$(data.sellerUid)/listings/$(data.listingId)).data;
        let product = data.pricePerUnitCents * data.quantity;
        let scaledTotal = data.totalCents * 1000;
        return get(shop).data.status == 'published' && offer.status == 'active' &&
          data.produceName == offer.produceName && data.unit == offer.unit &&
          data.pricePerUnitCents == offer.pricePerUnitCents &&
          data.quantity >= offer.minimumQuantity && data.quantity <= offer.availableQuantity &&
          (data.unit == 'kg'
            ? (product >= scaledTotal - 500 && product < scaledTotal + 500)
            : data.totalCents == product);
      }

      function validRequestedOrder(data) {
        return data.keys().hasOnly(['buyerUid', 'sellerUid', 'listingId', 'produceName',
          'unit', 'pricePerUnitCents', 'quantity', 'totalCents', 'status', 'createdAt', 'updatedAt']) &&
          data.buyerUid == request.auth.uid && data.sellerUid != data.buyerUid &&
          safeDocumentId(data.sellerUid) && safeDocumentId(data.listingId) &&
          data.pricePerUnitCents is int && data.pricePerUnitCents > 0 && data.pricePerUnitCents <= 1000000000 &&
          data.quantity is int && data.quantity > 0 && data.quantity <= 1000000000 &&
          data.totalCents is int && data.totalCents > 0 && data.totalCents <= 1000000000000 &&
          data.status == 'requested' && data.createdAt == request.time && data.updatedAt == request.time &&
          validOrderQuote(data);
      }

      function stockMatchesOrder(before, after) {
        let offer = /databases/$(database)/documents/market_profiles/$(before.sellerUid)/listings/$(before.listingId);
        let link = /databases/$(database)/documents/market_profiles/$(before.sellerUid)/listings/$(before.listingId)/operations/stock;
        return getAfter(link).data.orderId == orderId &&
          marketStockChange(get(offer).data, getAfter(offer).data, before, after);
      }

      function validOrderUpdate(before, after) {
        let seller = isOwner(before.sellerUid);
        let buyer = isOwner(before.buyerUid);
        let shop = /databases/$(database)/documents/market_profiles/$(before.sellerUid);
        let changes = after.diff(before).affectedKeys();
        return after.updatedAt == request.time && (
          (changes.hasOnly(['status', 'updatedAt']) && (
            (before.status == 'requested' && (
              (after.status == 'declined' && seller) ||
              (after.status == 'cancelled' && buyer) ||
              (after.status == 'accepted' && seller && get(shop).data.status == 'published' &&
               stockMatchesOrder(before, after)))) ||
            (before.status == 'accepted' && (
              (after.status == 'cancelled' && (seller || buyer)) ||
              (after.status == 'completed' && seller)) && stockMatchesOrder(before, after)))) ||
          (seller && before.status == 'accepted' &&
           changes.hasOnly(['pickupInstructions', 'updatedAt']) &&
           isValidString(after.pickupInstructions) && after.pickupInstructions.size() <= 500));
      }

      allow get: if isAuthenticated() && resource == null &&
        orderId.split('~')[0] == request.auth.uid;
      allow read: if isAuthenticated() &&
        (isOwner(resource.data.buyerUid) || isOwner(resource.data.sellerUid));
      allow create: if isAuthenticated() && orderId.split('~').size() == 2 &&
        orderId.split('~')[0] == request.auth.uid && isResetId(orderId.split('~')[1]) &&
        validRequestedOrder(request.resource.data);
      allow update: if isAuthenticated() && validOrderUpdate(resource.data, request.resource.data);
    }

    // ===== Deny everything else =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

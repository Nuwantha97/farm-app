rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== Helper Functions =====
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isValidString(field) {
      return field is string && field.size() > 0;
    }
    
    function isValidNumber(field) {
      return field is number && field >= 0;
    }

    function historyMarker(userId) {
      return /databases/$(database)/documents/users/$(userId)/history/archive;
    }

    function acceptsArchive(userId, data) {
      return !exists(historyMarker(userId)) ||
        (data.get('archivedAt', null) is timestamp &&
         data.archivedAt > get(historyMarker(userId)).data.clearedThrough);
    }

    function isArchivedCrop(data) {
      return data.get('isArchived', false) || data.get('archivedAt', null) != null;
    }

    function resetMarker(userId) {
      return /databases/$(database)/documents/users/$(userId)/operations/farm_reset;
    }

    function farmResetBatch(userId, before) {
      let after = getAfter(resetMarker(userId));
      return before != null && after != null && before.data.status == 'running' &&
        after.data.status == 'running' && after.data.generation == before.data.generation &&
        after.data.get('batchToken', '') != before.data.get('batchToken', '');
    }

    function farmResetDeletes(userId) {
      return farmResetBatch(userId, get(resetMarker(userId)));
    }

    function farmCanDelete(userId) {
      let state = get(resetMarker(userId));
      return state == null || state.data.status == 'complete' || farmResetBatch(userId, state);
    }

    function farmCanWrite(userId, data) {
      return !exists(resetMarker(userId)) ||
        (get(resetMarker(userId)).data.status == 'complete' &&
         data.get('farmGeneration', null) == get(resetMarker(userId)).data.generation);
    }

    function isResetId(value) {
      return value is string && value.matches('^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$');
    }

    function isRunningReset(data) {
      return data.keys().hasOnly(['generation', 'baseGeneration', 'status', 'batchToken']) &&
        data.status == 'running' && isResetId(data.generation) && isResetId(data.batchToken) &&
        (data.baseGeneration == null || isResetId(data.baseGeneration));
    }
    
    // ===== User Profile =====
    match /users/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);

      match /operations/farm_reset {
        allow get: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId) &&
          isRunningReset(request.resource.data) && request.resource.data.baseGeneration == null;
        allow update: if isAuthenticated() && isOwner(userId) && (
          (resource.data.status == 'complete' && isRunningReset(request.resource.data) &&
           request.resource.data.baseGeneration == resource.data.generation &&
           request.resource.data.generation != resource.data.generation) ||
          (resource.data.status == 'running' && resource.data.get('leaseUntil', request.time) <= request.time &&
           request.resource.data.generation == resource.data.generation && (
             (isRunningReset(request.resource.data) &&
              request.resource.data.baseGeneration == resource.data.baseGeneration &&
              request.resource.data.batchToken != resource.data.get('batchToken', '')) ||
             (request.resource.data.status == 'complete' &&
              request.resource.data.keys().hasOnly(['generation', 'status']))
           ))
        );
      }

      // A reset queries these collection groups under this user's document.
      // This exposes orphaned expenses whose crop document was deleted earlier.
      match /{parent=**}/expenses/{expenseId} {
        allow list: if isAuthenticated() && isOwner(userId) &&
          get(resetMarker(userId)).data.status == 'running';
      }

      match /{parent=**}/expenses_history/{expenseId} {
        allow list: if isAuthenticated() && isOwner(userId) &&
          get(resetMarker(userId)).data.status == 'running';
      }
      
      // ===== Crops =====
      match /crops/{cropId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId)
          && isValidString(request.resource.data.name)
          && isValidString(request.resource.data.type)
          && farmCanWrite(userId, request.resource.data)
          && (!isArchivedCrop(request.resource.data) || acceptsArchive(userId, request.resource.data));
        allow update: if isAuthenticated() && isOwner(userId)
          && farmCanWrite(userId, request.resource.data)
          && (!isArchivedCrop(request.resource.data) || acceptsArchive(userId, request.resource.data));
        allow delete: if isAuthenticated() && isOwner(userId) && farmCanDelete(userId);
        
        // ===== Crop Expenses =====
        match /expenses/{expenseId} {
          function ownerCropAcceptsExpense() {
            let crop = get(/databases/$(database)/documents/users/$(userId)/crops/$(cropId));
            return crop.data != null &&
              (!isArchivedCrop(crop.data) || acceptsArchive(userId, crop.data));
          }
          allow read: if isAuthenticated() && isOwner(userId);
          allow create: if isAuthenticated() && isOwner(userId)
            && isValidString(request.resource.data.title)
            && isValidNumber(request.resource.data.amount) && ownerCropAcceptsExpense()
            && farmCanWrite(userId, request.resource.data);
          allow update: if isAuthenticated() && isOwner(userId) && ownerCropAcceptsExpense()
            && farmCanWrite(userId, request.resource.data);
          allow delete: if isAuthenticated() && isOwner(userId) && farmCanDelete(userId);
        }
      }
      
      // ===== Common Expenses =====
      match /common_expenses/{expenseId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId)
          && isValidString(request.resource.data.title)
            && isValidNumber(request.resource.data.amount) && farmCanWrite(userId, request.resource.data);
        allow update: if isAuthenticated() && isOwner(userId) && farmCanWrite(userId, request.resource.data);
        allow delete: if isAuthenticated() && isOwner(userId) && farmCanDelete(userId);
      }
      
      // ===== Crop History (archived crops) =====
      match /crop_history/{historyId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create, update: if isAuthenticated() && isOwner(userId)
          && acceptsArchive(userId, request.resource.data) && farmCanWrite(userId, request.resource.data);
        allow delete: if isAuthenticated() && isOwner(userId) && farmCanDelete(userId);
      }

      match /history/archive {
        allow get: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId) && farmResetDeletes(userId);
        allow create, update: if isAuthenticated() && isOwner(userId)
          && request.resource.data.keys().hasOnly(['clearedThrough', 'farmGeneration'])
          && farmCanWrite(userId, request.resource.data)
          && request.resource.data.clearedThrough is timestamp
          && request.resource.data.clearedThrough <= request.time
          && (resource == null || request.resource.data.clearedThrough > resource.data.clearedThrough);

        match /crops_history/{cropId} {
          allow read: if isAuthenticated() && isOwner(userId);
          allow delete: if isAuthenticated() && isOwner(userId) && farmCanDelete(userId);
          allow create, update: if isAuthenticated() && isOwner(userId)
            && acceptsArchive(userId, request.resource.data) && farmCanWrite(userId, request.resource.data);

          match /expenses_history/{expenseId} {
            function parentAcceptsArchiveExpense() {
              let crop = get(/databases/$(database)/documents/users/$(userId)/history/archive/crops_history/$(cropId));
              return !exists(historyMarker(userId)) ||
                (crop.data != null && acceptsArchive(userId, crop.data));
            }
            allow read: if isAuthenticated() && isOwner(userId);
            allow delete: if isAuthenticated() && isOwner(userId) && farmCanDelete(userId);
            allow create, update: if isAuthenticated() && isOwner(userId)
              && acceptsArchive(userId, request.resource.data) && parentAcceptsArchiveExpense()
              && farmCanWrite(userId, request.resource.data);
          }
        }

        match /common_expenses_history/{expenseId} {
          allow read: if isAuthenticated() && isOwner(userId);
          allow delete: if isAuthenticated() && isOwner(userId) && farmCanDelete(userId);
          allow create, update: if isAuthenticated() && isOwner(userId)
            && acceptsArchive(userId, request.resource.data) && farmCanWrite(userId, request.resource.data);
        }
      }
      
      // ===== Sales =====
      match /sales/{saleId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId)
          && isValidString(request.resource.data.cropId)
            && isValidNumber(request.resource.data.amount) && farmCanWrite(userId, request.resource.data);
        allow update: if isAuthenticated() && isOwner(userId) && farmCanWrite(userId, request.resource.data);
        allow delete: if isAuthenticated() && isOwner(userId) && farmCanDelete(userId);
      }
    }
    
    // ===== Market =====
    match /market_places/{placeId} {
      allow read: if isAuthenticated();
    }

    match /market_profiles/{sellerUid} {
      allow get: if isAuthenticated() &&
        (isOwner(sellerUid) || resource.data.status == 'published');
      allow list: if isAuthenticated() && resource.data.status == 'published';

      match /listings/{listingId} {
        allow read: if isAuthenticated() && (isOwner(sellerUid) ||
          (resource.data.status == 'active' &&
           get(/databases/$(database)/documents/market_profiles/$(sellerUid)).data.status == 'published'));
      }
    }

    match /market_orders/{orderId} {
      allow read: if isAuthenticated() &&
        (isOwner(resource.data.buyerUid) || isOwner(resource.data.sellerUid));
    }

    // ===== Deny everything else =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
